<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ru.morozova.posts-emdr</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_ROOT__/scripts/local-publish-wrapper.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>12</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>TimeZone</key>
  <string>Europe/Moscow</string>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/posts-emdr-memory/logs/launchd-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/posts-emdr-memory/logs/launchd-stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BROWSER_BACKEND</key>
    <string>undetectable</string>
  </dict>
</dict>
</plist>
