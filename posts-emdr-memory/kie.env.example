# Kie.ai — обложки Posts EMDR (тот же ключ, что Carusel)
# Скопируйте в kie.env.local или используйте Carusel/.env
# Ключ: https://kie.ai/api-key

KIE_API_KEY=

# Cover defaults (5:4 ≈ 1280×1024)
KIE_COVER_ASPECT_RATIO=5:4
KIE_COVER_RESOLUTION=1K

# Опционально — глобальный override портрета (не рекомендуется)
# KIE_REFERENCE_IMAGE=
