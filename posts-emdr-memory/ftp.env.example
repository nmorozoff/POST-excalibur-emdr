# FTP — загрузка обложек на morozovanatalia.ru/social-covers
# Cloud: Runtime Secrets в cursor.com/dashboard/cloud-agents

FTP_SERVER=
FTP_USERNAME=
FTP_PASSWORD=
FTP_SERVER_DIR=/public_html/

# Опционально — fallback если passive FTP заблокирован в Cloud (Application Password в WP)
WORDPRESS_URL=https://morozovanatalia.ru
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
