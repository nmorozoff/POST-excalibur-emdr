# Reverse proxy for Undetectable Local API (mode A only).
# Install on Windows VPS: nginx for Windows, or IIS ARR.
# NEVER expose :25325 without Bearer + TLS.

# Generate bearer: openssl rand -hex 32
# Set same value in Cursor Secrets as UNDETECTABLE_API_BEARER
# and in map $http_authorization $auth_ok below via env or include.

upstream undetectable_local {
    server 127.0.0.1:25325;
    keepalive 8;
}

server {
    listen 443 ssl http2;
    server_name browser-bridge.example.com;

    ssl_certificate     /etc/ssl/certs/browser-bridge.crt;
    ssl_certificate_key /etc/ssl/private/browser-bridge.key;

    # Replace with your secret token (also in UNDETECTABLE_API_BEARER)
    set $expected_bearer "REPLACE_WITH_LONG_RANDOM_TOKEN";

    location / {
        if ($http_authorization != "Bearer $expected_bearer") {
            return 401;
        }

        proxy_pass http://undetectable_local;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 50m;
    }
}

# Health from cloud:
# curl -s -H "Authorization: Bearer TOKEN" https://browser-bridge.example.com/status
