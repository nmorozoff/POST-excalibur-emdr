# Runware — локальные секреты (НЕ коммитить)
# Скопируйте в runware.env.local и заполните
# Dashboard: https://runware.ai/

RUNWARE_API_KEY=

# Defaults for covers (GPT Image 2, openai:gpt-image@2)
# Каналы: 1280×1024 (5:4), quality low
RUNWARE_COVER_WIDTH=1280
RUNWARE_COVER_HEIGHT=1024
RUNWARE_COVER_QUALITY=low
