# Grsai — обложки Posts EMDR (GPT Image 2)
# Скопируйте в grsai.env.local и вставьте ключ после =
# Документация: https://grsaiapi.com — модель gpt-image-2
#
# НЕ храните ключ здесь — только в grsai.env.local (локально) или Cloud Secrets.

GRSAI_API_KEY=

# API host (Global по умолчанию; из Китая — https://grsai.dakka.com.cn)
GRSAI_API_BASE=https://grsaiapi.com

# Обложка short-blog: 5:4 → 1280×1024 (согласовано с пайплайном)
GRSAI_COVER_ASPECT_RATIO=1280x1024

# quality: auto | low | medium | high
GRSAI_COVER_QUALITY=low

# Модель: gpt-image-2 | gpt-image-2-vip
GRSAI_COVER_MODEL=gpt-image-2
