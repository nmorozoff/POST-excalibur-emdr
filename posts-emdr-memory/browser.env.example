# Browser backend — Linux VPS (Playwright)
# cp browser.env.example browser.env.local

# playwright = Linux VPS без Undetectable/Windows
# undetectable = Mac + Undetectable Local API
BROWSER_BACKEND=playwright

# Cookies после browser_bootstrap_sessions.py (НЕ коммитить)
PLAYWRIGHT_STORAGE_STATE=posts-emdr-memory/browser/linux-storage-state.json

# 1 = headless на VPS, 0 = отладка с xvfb --headed
PLAYWRIGHT_HEADLESS=1
