# Browser backend — Linux VPS (Playwright, без Mac)
# cp browser.env.example browser.env.local

BROWSER_BACKEND=playwright

# Cookies (один раз экспорт с Undetectable → scp на VPS, дальше обновляются автоматически)
PLAYWRIGHT_STORAGE_STATE=posts-emdr-memory/browser/linux-storage-state.json

# 1 = headless на VPS
PLAYWRIGHT_HEADLESS=1

# --- ASocks API (scripts/asocks_sync_proxy.py, scripts/asocks_check.py) ---
ASOCKS_API_BASE=https://api.asocks.com
ASOCKS_API_KEY=
ASOCKS_PORT_NAME=b17-emdr-vps

# --- b17.ru: обязателен residential proxy (датацентр VPS заблокирован) ---
# Порт подключения: в кабинете ASocks часто 443 (API template может показывать 9999)
B17_PROXY_CONNECT_PORT=443
B17_PROXY_SERVER=
B17_PROXY_USERNAME=
B17_PROXY_PASSWORD=
ASOCKS_PORT_ID=

# --- Telegram Bot API: ASocks KZ (api.telegram.org недоступен с VPS/Cloud DC) ---
TELEGRAM_ASOCKS_PORT_NAME=ResKazakhstan - Turkestan
TELEGRAM_PROXY_CONNECT_PORT=443
TELEGRAM_PROXY_SERVER=
TELEGRAM_PROXY_USERNAME=
TELEGRAM_PROXY_PASSWORD=
# TELEGRAM_ASOCKS_PORT_ID=

# Опционально: общий proxy для TenChat (обычно не нужен)
# BROWSER_PROXY_SERVER=

# Webhook (vps-webhook-server.py) — секрет для вызова из cloud automation
# VPS_WEBHOOK_SECRET=
